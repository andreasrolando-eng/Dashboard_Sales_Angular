# Salin ke .env  (cp .env.example .env). File .env WAJIB ada di .gitignore.
APP_SLUG=dashboard-sales
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:4200

# PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/app_db?sslmode=disable

# operations-sso — client development (pilih salah satu sesuai port backend:
# 8080 langsung, 80 lewat docker compose/nginx, atau 3000).
# Nilai client_id/client_secret dev resmi ada di skill esb-ops-dev-stack,
# references/sso.md ("Client development (khusus localhost)") — salin dari
# sana, jangan commit nilai asli client_secret ke file lain selain .env.
OIDC_ISSUER=https://operations.esb.co.id/sso
OIDC_CLIENT_ID=<test-local-8080 | test-local-80 | test-local>
OIDC_CLIENT_SECRET=<lihat references/sso.md>
OIDC_REDIRECT_URL=http://localhost:8080/auth/sso/callback

SESSION_SECRET=ganti-dengan-string-acak-32-karakter

# ESB OMS API — dibutuhkan buat `server sync run` (M3 ETL). Isi dengan
# kredensial staging/production yang sebenarnya, jangan commit nilainya.
ESB_API_BASE_URL=https://stg7.esb.co.id/api-fnb-backend/web
ESB_API_KEY=

# Opsional — ping healthchecks.io tiap `server sync run` selesai (sukses
# maupun gagal). Kosongkan kalau tidak dipakai.
HEALTHCHECKS_PING_URL=

# Scheduler ETL harian (jalan di dalam `server serve`). Default: aktif hanya
# kalau APP_ENV=production. Butuh ESB_API_BASE_URL + ESB_API_KEY terisi.
# Saat start & tiap hari jam SYNC_HOUR_WIB (WIB), menyinkron semua tanggal
# dalam SYNC_CATCHUP_DAYS hari terakhir yang belum pernah sukses, lalu menarik
# ulang SYNC_REFRESH_DAYS hari terakhir yang sudah tersinkron (void susulan
# ikut masuk). 0 = tanpa tarik ulang.
SYNC_SCHEDULER_ENABLED=
SYNC_HOUR_WIB=6
SYNC_CATCHUP_DAYS=7
SYNC_REFRESH_DAYS=3
# Webhook incoming Slack/Discord — dipanggil kalau ada hari yang gagal sync.
SYNC_ALERT_WEBHOOK_URL=

# Login lokal (email + password). Sesi disimpan di database; cookie HttpOnly.
# SESSION_TTL_HOURS: lama satu sesi login (default 12).
# COOKIE_SECURE: default true saat APP_ENV=production, artinya cookie hanya dikirim
# lewat HTTPS. Kalau aplikasi dilayani lewat HTTP polos (tanpa TLS), set false —
# kalau tidak browser membuang cookie dan login akan terus berulang.
# Password admin pertama: `server user set-password --email=EMAIL --admin`
# (di server: docker compose exec api /app/server user set-password --email=EMAIL --admin)
SESSION_TTL_HOURS=12
COOKIE_SECURE=
