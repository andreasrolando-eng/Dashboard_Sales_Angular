# Template .env PRODUCTION -> salin ke /opt/apps/<slug>/.env di SERVER, lalu isi.
# Jangan pernah di-commit dengan nilai asli. Penjelasan lengkap: docs/deploy-production.md
#
# PENTING: deploy.sh men-`source` file ini. Nilai yang mengandung spasi, < > & # $ ;
# WAJIB diberi tanda kutip ("...").

# --- Identitas & jaringan -----------------------------------------------------
APP_SLUG=dashboard-sales          # = nama repo/folder (huruf kecil)
APP_ENV=production                # mengaktifkan scheduler sinkron + cookie Secure
PUBLISH_PORT=8000                 # port host untuk web-app; isi sesuai DevOps

# --- Database ----------------------------------------------------------------
# Dipakai container db DAN deploy.sh. Pakai password alfanumerik (openssl rand -hex 24).
POSTGRES_USER=app
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK
POSTGRES_DB=app_db
DATABASE_URL=postgres://app:GANTI_DENGAN_PASSWORD_ACAK@db:5432/app_db?sslmode=disable

# --- ESB OMS API (kredensial PRODUCTION, bukan staging) ------------------------
ESB_API_BASE_URL=https://GANTI/api-fnb-backend/web
ESB_API_KEY=GANTI

# --- Sinkron otomatis (default sudah sesuai; ubah bila perlu) ------------------
#SYNC_HOUR_WIB=6                  # jam sinkron harian (WIB)
#SYNC_CATCHUP_DAYS=7              # mengejar tanggal yang belum sukses, sejauh N hari
#SYNC_REFRESH_DAYS=3              # tarik ulang N hari terakhir yang sudah sukses (void susulan); 0 = mati
SYNC_ALERT_WEBHOOK_URL=""         # webhook Slack/Discord; kosongkan bila tak dipakai (pakai kutip!)
HEALTHCHECKS_PING_URL=""          # opsional (healthchecks.io)

# --- Login ------------------------------------------------------------------
#SESSION_TTL_HOURS=12
# Cookie sesi hanya lewat HTTPS secara default di production. Set false HANYA bila
# aplikasi dilayani lewat HTTP polos (tanpa TLS), kalau tidak login akan berulang terus.
#COOKIE_SECURE=false
